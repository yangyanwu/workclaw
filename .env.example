# ============================================================
# WorkClaw Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider ---
# Options: openai, anthropic, google, ollama
WORKCLAW_LLM_PROVIDER=openai
WORKCLAW_LLM_MODEL=gpt-4o

# API Keys (set the one matching your provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# For Ollama, no key needed — just set the base URL:
# OLLAMA_API_BASE=http://localhost:11434

# --- GitHub ---
GITHUB_TOKEN=
# Optional: default org/owner for repo operations
GITHUB_DEFAULT_OWNER=

# --- Bitbucket ---
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
# Optional: default workspace
BITBUCKET_DEFAULT_WORKSPACE=

# --- Jira ---
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: default project key
JIRA_DEFAULT_PROJECT=

# --- Storage ---
# WORKCLAW_DATA_DIR=~/.workclaw/data
# WORKCLAW_WORKSPACE_DIR=~/.workclaw/workspaces
